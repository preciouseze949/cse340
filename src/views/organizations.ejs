<%- include('partials/header') %>

    <main class="content-page">

        <section class="page-intro">
            <p class="eyebrow">WORKING TOGETHER</p>

            <h1>
                <%= title %>
            </h1>

            <p>
                Meet some of our partner organizations working to make
                a positive difference in communities around the world.
            </p>
        </section>

        <section class="organizations-section">
            <h2>Our Partner Organizations</h2>

            <div class="organization-grid">

                <article class="organization-card">
                    <img src="/images/brightfuture-logo.png" alt="BrightFuture Builders logo" loading="lazy">

                    <h3>BrightFuture Builders</h3>

                    <p>
                        Supporting communities through meaningful
                        development and service opportunities.
                    </p>

                    <a href="mailto:info@brightfuture.org">
                        info@brightfuture.org
                    </a>
                </article>

                <article class="organization-card">
                    <img src="/images/greenharvest-logo.png" alt="GreenHarvest Growers logo" loading="lazy">

                    <h3>GreenHarvest Growers</h3>

                    <p>
                        Promoting environmental sustainability,
                        agriculture, and community development.
                    </p>

                    <a href="mailto:contact@greenharvest.org">
                        contact@greenharvest.org
                    </a>
                </article>

                <article class="organization-card">
                    <img src="/images/unityserve-logo.png" alt="UnityServe Volunteers logo" loading="lazy">

                    <h3>UnityServe Volunteers</h3>

                    <p>
                        Connecting volunteers with meaningful
                        opportunities to serve their communities.
                    </p>

                    <a href="mailto:hello@unityserve.org">
                        hello@unityserve.org
                    </a>
                </article>

            </div>
        </section>

    </main>

    <%- include('partials/footer') %>