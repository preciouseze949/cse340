
<%- include('partials/header') %>

<main class="content-page">

    <section class="page-intro">
        <p class="eyebrow">WORKING TOGETHER</p>

        <h1><%= title %></h1>

        <p>
            Meet our partner organizations working to make
            a positive difference in communities around the world.
        </p>
    </section>

    <section class="organizations-section">

        <h2>Our Partner Organizations</h2>

        <% if (organizations.length > 0) { %>

            <div class="organization-grid">

                <% organizations.forEach((organization) => { %>

                    <article class="organization-card">

                        <img
                            src="/images/<%= organization.logo_filename %>"
                            alt="<%= organization.name %> logo"
                            loading="lazy"
                        >

                        <h3>
                            <%= organization.name %>
                        </h3>

                        <p>
                            <%= organization.description %>
                        </p>

                        <a href="mailto:<%= organization.contact_email %>">
                            <%= organization.contact_email %>
                        </a>

                    </article>

                <% }) %>

            </div>

        <% } else { %>

            <p>No organizations are currently available.</p>

        <% } %>

    </section>

</main>

<%- include('partials/footer') %>
