<%- include('partials/header') %>

    <main class="content-page">

        <section class="page-intro">
            <p class="eyebrow">FIND YOUR PURPOSE</p>

            <h1>
                <%= title %>
            </h1>

            <p>
                Explore different service categories and find meaningful
                ways to contribute your time and skills.
            </p>
        </section>

        <section class="categories-section">

            <div class="category-grid">

                <article class="category-card">
                    <span class="category-number">01</span>
                    <h2>Environmental</h2>

                    <p>
                        Participate in activities that protect the environment,
                        preserve natural resources, and promote sustainability.
                    </p>
                </article>

                <article class="category-card">
                    <span class="category-number">02</span>
                    <h2>Educational</h2>

                    <p>
                        Support learning through tutoring, mentoring,
                        literacy programs, and educational outreach.
                    </p>
                </article>

                <article class="category-card">
                    <span class="category-number">03</span>
                    <h2>Community Service</h2>

                    <p>
                        Strengthen communities through volunteering,
                        neighborhood improvement, and outreach programs.
                    </p>
                </article>

                <article class="category-card">
                    <span class="category-number">04</span>
                    <h2>Health and Wellness</h2>

                    <p>
                        Promote healthier communities through wellness
                        activities, health education, and support initiatives.
                    </p>
                </article>

            </div>

        </section>

    </main>

    <%- include('partials/footer') %>