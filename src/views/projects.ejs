
<%- include('partials/header') %>

<main class="content-page">

    <section class="page-intro">
        <p class="eyebrow">GET INVOLVED</p>

        <h1><%= title %></h1>

        <p>
            Discover opportunities to make a positive difference
            through volunteering and community service.
        </p>
    </section>

    <section class="projects-section">

        <h2>Available Service Projects</h2>

        <% if (projects.length > 0) { %>

            <div class="project-grid">

                <% projects.forEach((project) => { %>

                    <article class="project-card">

                        <h3>
                            <%= project.title %>
                        </h3>

                        <p>
                            <strong>Date:</strong>
                            <%= new Date(
                                project.project_date + 'T00:00:00'
                            ).toLocaleDateString('en-GB', {
                                day: 'numeric',
                                month: 'long',
                                year: 'numeric'
                            }) %>
                        </p>

                        <p>
                            <strong>Organization:</strong>
                            <%= project.organization_name %>
                        </p>

                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>

                        <p>
                            <%= project.description %>
                        </p>

                    </article>

                <% }) %>

            </div>

        <% } else { %>

            <p>No service projects are currently available.</p>

        <% } %>

    </section>

</main>

<%- include('partials/footer') %>
