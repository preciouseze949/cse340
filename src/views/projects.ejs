<%- include('partials/header') %>

    <main class="content-page">

        <section class="page-intro">
            <p class="eyebrow">GET INVOLVED</p>

            <h1>
                <%= title %>
            </h1>

            <p>
                Discover opportunities to make a positive difference
                through volunteering and community service.
            </p>
        </section>

        <section class="projects-section">

            <h2>Upcoming Service Projects</h2>

            <div class="project-grid">

                <article class="project-card">
                    <span class="project-number">01</span>
                    <h3>Park Cleanup</h3>

                    <p>
                        Join us to clean up local parks and make them beautiful!
                    </p>
                </article>

                <article class="project-card">
                    <span class="project-number">02</span>
                    <h3>Food Drive</h3>

                    <p>
                        Help collect and distribute food to those in need.
                    </p>
                </article>

                <article class="project-card">
                    <span class="project-number">03</span>
                    <h3>Community Tutoring</h3>

                    <p>
                        Volunteer to tutor students in various subjects.
                    </p>
                </article>

            </div>

        </section>

    </main>

    <%- include('partials/footer') %>